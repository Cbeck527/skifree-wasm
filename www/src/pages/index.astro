---
import { Image } from "astro:assets";
import screenshot from "../assets/public-mountain.png";
import "../styles/global.css";

const repo = "https://github.com/cbeck527/skifree-wasm";
const mountain = "https://ski.becker.foo/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="A reverse-engineered C port of SkiFree (1991), compiled to WebAssembly, with one public multiplayer mountain."
    />
    <meta name="theme-color" content="#ffffff" />
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 32 32%22><rect width=%2232%22 height=%2232%22 rx=%226%22 fill=%22%23ffffff%22 stroke=%22%23000000%22 stroke-width=%222%22/><path d=%22M16 5l7 12h-4l5 8H8l5-8H9z%22 fill=%22%2300bf00%22 stroke=%22%23000000%22 stroke-width=%221.5%22 stroke-linejoin=%22round%22/><rect x=%2214.5%22 y=%2225%22 width=%223%22 height=%223%22 fill=%22%23000000%22/></svg>"
    />
    <title>skifree-wasm — cmb.software</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="page">
      <header class="site-header">
        <a class="brand" href="/">cmb.software</a>
        <span class="slash" aria-hidden="true">/</span>
        <span class="project">skifree-wasm</span>
        <a
          class="github-link"
          href={repo}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="View skifree-wasm on GitHub"
          title="View on GitHub"
        >
          <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24">
            <path
              d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.385-1.335-1.754-1.335-1.754-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.237 1.838 1.237 1.07 1.835 2.809 1.305 3.495.998.108-.776.418-1.305.762-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
            ></path>
          </svg>
        </a>
      </header>

      <main id="main">
        <section class="hero" aria-labelledby="hero-title">
          <h1 id="hero-title">SkiFree, rebuilt<br />for the browser.</h1>
          <p class="intro">
            A from-the-binary C port of Chris Pirih’s 1991 classic, compiled to
            WebAssembly, with one public mountain everyone skis together.
          </p>

          <div class="actions">
            <a class="button button-primary" href={mountain}>
              Ski the public mountain <span aria-hidden="true">→</span>
            </a>
            <a class="button" href={`${mountain}?single=1`}>
              Play single-player
            </a>
          </div>

          <Image
            class="screenshot"
            src={screenshot}
            alt="The public mountain in a browser: the SkiFree logo, one skier labelled “Skier-8 (you)”, and the multiplayer status and controls panels."
            widths={[800, 1200, 1600, 2296]}
            sizes="(max-width: 980px) 100vw, 920px"
            loading="eager"
          />
        </section>
      </main>
      <footer class="site-footer">
        <p>⛷️ Built with C and WebAssembly</p>
        <p class="fineprint">
          SkiFree is © Chris Pirih. This is an unofficial port; the repository
          contains none of the original binaries; the screenshot above shows the
          game’s graphics.
        </p>
      </footer>
    </div>
  </body>
</html>
